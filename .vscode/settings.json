{
    // Python Interpreter
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

    // Linting
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.linting.flake8Args": [
        "--max-line-length=120",
        "--ignore=E203,W503"
    ],

    // Formatting
    "python.formatting.provider": "black",
    "python.formatting.blackArgs": [
        "--line-length=120"
    ],
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },

    // File exclusions
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        ".pytest_cache": true,
        "**/.DS_Store": true,
        ".venv": true
    },

    // Search exclusions
    "search.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/venv": true,
        "**/models": true,
        "**/uploads": true,
        "**/outputs": true
    },

    // Python Analysis (Pylance)
    "python.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/api",
        "${workspaceFolder}/core",
        "${workspaceFolder}/utils"
    ],
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "warning",
        "reportMissingTypeStubs": "none"
    },

    // Auto-complete
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/api",
        "${workspaceFolder}/core",
        "${workspaceFolder}/utils"
    ],

    // Testing
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "."
    ],

    // Terminal
    "terminal.integrated.env.osx": {
        "PYTHONPATH": "${workspaceFolder}"
    },
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}"
    },

    // Editor
    "editor.rulers": [120],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    // Files
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.associations": {
        "*.py": "python",
        ".env.*": "dotenv"
    },

    // Git
    "git.ignoreLimitWarning": true,

    // ============ CONTINUE AI НАСТРОЙКИ ============

    // Continue базовые настройки
    "continue.enableTabAutocomplete": true,
    "continue.pauseTabAutocompleteOnBattery": false,  // M4 Max энергоэффективный
    "continue.showSuggestionInGhostText": true,
    "continue.enableDebugLogs": false,

    // Оптимизация для больших моделей на M4 Max
    // qwen2.5-coder: 32768, deepseek-coder-v2: 163840, llama3.1: 131072
    "continue.maxContextLength": 32768,  // Увеличено для лучшего понимания кода
    "continue.chunkSize": 1000,  // Увеличено для более эффективной обработки
    "continue.streamResponse": true,

    // Автокомплит настройки
    "continue.tabAutocompleteOptions": {
        "multilineCompletions": "always",
        "maxPromptTokens": 2000,
        "debounceDelay": 150,
        "maxSuffixTokens": 1000,
        "triggers": {
            "python": ["def ", "class ", "if ", "for ", "while ", "import ", "from "],
            "javascript": ["function ", "const ", "let ", "var ", "if ", "for "],
            "typescript": ["function ", "const ", "let ", "var ", "interface ", "type "]
        }
    },

    // Горячие клавиши для Continue
    "continue.shortcuts": {
        "accept": "Tab",
        "reject": "Escape",
        "toggleChat": "cmd+l",
        "inlineEdit": "cmd+shift+k",
        "quickActions": "cmd+shift+l"
    },

    // Отключаем конфликтующие AI функции
    "cursor.copilotEnabled": false,  // Если есть GitHub Copilot
    "github.copilot.enable": false,  // Отключаем GitHub Copilot

    // Continue UI настройки
    "continue.showInlineCompletions": true,
    "continue.showStatusBar": true,
    "continue.suggestionDelay": 200,

    // Настройки для Python с Continue
    "continue.pythonOptions": {
        "useBlackFormatter": true,
        "maxLineLength": 120,
        "includeDocstrings": true,
        "includeTypeHints": true
    },

    // Разрешения для инструментов Continue
    "continue.allowCodeActions": true,
    "continue.allowFileRead": true,
    "continue.allowFileWrite": true,
    "continue.allowTerminalCommands": true,

    // ============ КОНЕЦ CONTINUE НАСТРОЕК ============

    // Specific file type settings
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        }
    }
}
